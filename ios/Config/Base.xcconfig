// Shared build settings. Per-operator files set identity only.
IPHONEOS_DEPLOYMENT_TARGET = 27.0
SWIFT_VERSION = 6.0
TARGETED_DEVICE_FAMILY = 1
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
// Development API. Override per configuration for staging/production.
API_BASE_URL = http:/$()/localhost:3000/

// ---------------------------------------------------------------------------
// Signing (set once). CI builds unsigned and ignores these.
// DEVELOPMENT_TEAM: your Apple Developer Team ID (Xcode > Settings > Accounts).
// BUNDLE_ID_PREFIX: a reverse-DNS prefix you own, e.g. uk.co.gitwork
DEVELOPMENT_TEAM =
BUNDLE_ID_PREFIX = com.example
CODE_SIGN_STYLE = Automatic
