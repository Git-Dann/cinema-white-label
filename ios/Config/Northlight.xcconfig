#include "Base.xcconfig"
// Build-time identity for the fictional Northlight Cinemas app.
APP_BUNDLE_ID = $(BUNDLE_ID_PREFIX).northlight.cinema
APP_NAME = Northlight
TENANT_SLUG = northlight
// Icon Composer icon in Resources/CinemaIcon.icon (needs Xcode 26). The
// AppIcon-Northlight asset set stays as the flat icon for older tooling.
ASSETCATALOG_COMPILER_APPICON_NAME = CinemaIcon
