{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "p=${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}; git cat-file -e \"$p^{commit}\" 2>/dev/null && git diff --quiet \"$p\" HEAD -- site",
  "git": { "deploymentEnabled": { "**": false, "main": true } },
  "framework": null,
  "installCommand": "",
  "buildCommand": "node site/tools/build.mjs",
  "outputDirectory": "site",
  "headers": [
    { "source": "/(site\\.[0-9a-f]{10}\\.css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
