// Cinema platform domain model.
// Money is always stored in minor units (pence). Timestamps are UTC; customer
// facing times are rendered in the venue's time zone.

generator client {
  provider      = "prisma-client-js"
  // native for development and CI; rhel-openssl-3.0.x for Vercel functions.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy, branding and configuration
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  locale    String   @default("en-GB")
  currency  String   @default("GBP")
  timeZone  String   @default("Europe/London")
  createdAt DateTime @default(now())

  // Commercial rules (backend-evaluated, not part of the published theme config).
  bookingFeeMinor           Int    @default(0)
  maxTicketsPerBooking      Int    @default(10)
  holdDurationSeconds       Int    @default(480)
  /// "allow" | "warn" | "block" — single empty seats left between selections.
  orphanSeatPolicy          String @default("warn")
  /// "none" | "warn" | "requireWheelchair"
  companionPolicy           String @default("warn")
  /// Customers may cancel up to this many minutes before the screening.
  cancellationCutoffMinutes Int    @default(60)

  settings           TenantSettings?
  palettes           BrandPalette[]
  releases           ConfigRelease[]
  venues             Venue[]
  films              Film[]
  screenings         Screening[]
  ticketTypes        TicketType[]
  priceRules         PriceRule[]
  formatSupplements  FormatSupplement[]
  customers          Customer[]
  bookings           Booking[]
  holds              SeatHold[]
  adminUsers         AdminUser[]
  mediaAssets        MediaAsset[]
  membershipPlans    MembershipPlan[]
  concessionProducts ConcessionProduct[]
  seatCategories     SeatCategory[]
  vouchers           Voucher[]
  promotions         Promotion[]
  apiKeys            ApiKey[]
  webhooks           Webhook[]
  shifts             Shift[]
  loyaltyProgram     LoyaltyProgram?
}

/// Operator-configurable seat category: label, shape, icon and colours.
/// `code` matches Seat.priceCategory in layouts and PriceRule.priceCategory.
model SeatCategory {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String
  label       String
  description String?
  shape       String
  icon        String?
  /// { light: { fill, accent }, dark: { fill, accent } } or null for theme tokens.
  colours     Json?
  sortOrder   Int     @default(0)

  @@unique([tenantId, code])
}

/// Editable draft configuration. Publishing snapshots it into a ConfigRelease.
model TenantSettings {
  tenantId  String   @id
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Draft config: theme, palette, features, home sections, support, legal, booking.
  draft     Json
  updatedAt DateTime @updatedAt
}

/// An approved brand palette. Only approved palettes can be published.
model BrandPalette {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  accentLight    String
  accentDark     String
  secondaryLight String
  secondaryDark  String
  approved       Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([tenantId])
}

enum ReleaseStatus {
  SCHEDULED
  PUBLISHED
  SUPERSEDED
  CANCELLED
}

/// Immutable, validated tenant configuration snapshot served to apps.
model ConfigRelease {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  version      Int
  status       ReleaseStatus
  snapshot     Json
  note         String?
  scheduledFor DateTime?
  publishedAt  DateTime?
  createdById  String?
  createdAt    DateTime      @default(now())

  @@unique([tenantId, version])
  @@index([tenantId, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  actorId    String?
  action     String
  entityType String
  entityId   String?
  data       Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

enum AdminRole {
  PLATFORM_ADMIN
  OPERATOR_ADMIN
  VENUE_MANAGER
  CONTENT_EDITOR
  REPORTING
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole
  /// Null only for platform administrators.
  tenantId     String?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Venues and auditoriums
// ---------------------------------------------------------------------------

model Venue {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug         String
  name         String
  addressLine1 String
  city         String
  postcode     String
  latitude     Float
  longitude    Float
  timeZone     String   @default("Europe/London")
  phone        String?
  facilities   String[]
  /// Location-level overrides of tenant feature flags, e.g. { "concessions": true, "seatDelivery": false }.
  features     Json     @default("{}")
  createdAt    DateTime @default(now())

  auditoriums Auditorium[]
  screenings  Screening[]
  favourites  FavouriteVenue[]
  shifts      Shift[]

  @@unique([tenantId, slug])
}

model Auditorium {
  id           String @id @default(cuid())
  tenantId     String
  venueId      String
  venue        Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name         String
  screenNumber Int

  layouts    AuditoriumLayoutVersion[]
  screenings Screening[]

  @@unique([venueId, screenNumber])
}

enum LayoutStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

/// Versioned physical seat geometry. Published versions are immutable.
model AuditoriumLayoutVersion {
  id           String       @id @default(cuid())
  auditoriumId String
  auditorium   Auditorium   @relation(fields: [auditoriumId], references: [id], onDelete: Cascade)
  version      Int
  status       LayoutStatus
  geometry     Json
  seatCount    Int
  publishedAt  DateTime?
  createdAt    DateTime     @default(now())

  screenings Screening[]

  @@unique([auditoriumId, version])
}

// ---------------------------------------------------------------------------
// Films and media
// ---------------------------------------------------------------------------

model Film {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug             String
  title            String
  tagline          String?
  synopsis         String
  releaseDate      DateTime @db.Date
  runtimeMinutes   Int
  certificate      String
  genres           String[]
  director         String?
  cast             String[]
  originalLanguage String   @default("en")
  /// Hidden films are left out of listings (e.g. the fictional catalogue once a
  /// real demo catalogue is loaded). Existing bookings still resolve them.
  hidden           Boolean  @default(false)
  /// Rich details for the film page: cast with photos and biographies, crew, About,
  /// BBFC content advice. Shape: src/catalogue/film-details.ts (FilmDetails).
  details          Json     @default("{}")
  /// Field-level provenance: { fieldName: providerId }.
  provenance       Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  externalIds FilmExternalId[]
  assets      MediaAsset[]
  trailers    Trailer[]
  screenings  Screening[]

  @@unique([tenantId, slug])
}

model FilmExternalId {
  id         String @id @default(cuid())
  tenantId   String
  filmId     String
  film       Film   @relation(fields: [filmId], references: [id], onDelete: Cascade)
  provider   String
  externalId String

  @@unique([tenantId, provider, externalId])
}

enum AssetKind {
  POSTER
  BACKDROP
  HERO
  THUMBNAIL
  BANNER
  TRAILER_THUMBNAIL
  LOGO
  PRODUCT
}

/// Bytes of operator uploads. Kept in the database so uploads survive on
/// serverless hosts, where the filesystem is temporary. Images are resized
/// before storage, so rows stay small. Fixture artwork is read from disk.
model MediaBlob {
  storageKey String   @id
  data       Bytes
  createdAt  DateTime @default(now())
}

model MediaAsset {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  filmId            String?
  film              Film?     @relation(fields: [filmId], references: [id], onDelete: Cascade)
  kind              AssetKind
  provider          String
  sourceRef         String
  licenceRef        String?
  attribution       String?
  usageRestrictions String?
  expiresAt         DateTime?
  language          String?
  territory         String?
  width             Int
  height            Int
  mimeType          String
  /// Path relative to the media root, or object storage key in production.
  storageKey        String
  /// Focal point (0-1) used for responsive cropping.
  focalX            Float     @default(0.5)
  focalY            Float     @default(0.5)
  dominantColor     String?
  approvedContexts  String[]
  isPreferred       Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([filmId, kind])
}

model Trailer {
  id              String  @id @default(cuid())
  filmId          String
  film            Film    @relation(fields: [filmId], references: [id], onDelete: Cascade)
  title           String
  kind            String  @default("trailer")
  /// HLS or MP4 URL from a licensed source. Null in development fixtures.
  url             String?
  durationSeconds Int?
  provider        String
  sortOrder       Int     @default(0)
}

// ---------------------------------------------------------------------------
// Screenings, inventory and holds
// ---------------------------------------------------------------------------

enum ScreeningStatus {
  SCHEDULED
  CANCELLED
}

model Screening {
  id              String                  @id @default(cuid())
  tenantId        String
  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venueId         String
  venue           Venue                   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  auditoriumId    String
  auditorium      Auditorium              @relation(fields: [auditoriumId], references: [id], onDelete: Cascade)
  layoutVersionId String
  layoutVersion   AuditoriumLayoutVersion @relation(fields: [layoutVersionId], references: [id])
  filmId          String
  film            Film                    @relation(fields: [filmId], references: [id], onDelete: Cascade)
  startsAt        DateTime
  endsAt          DateTime
  /// e.g. ["2D"], ["IMAX", "3D"], ["Dolby Atmos"].
  formats         String[]
  /// e.g. ["Subtitled", "Audio Described", "Relaxed"].
  attributes      String[]
  status          ScreeningStatus         @default(SCHEDULED)
  createdAt       DateTime                @default(now())

  seats    ScreeningSeat[]
  holds    SeatHold[]
  bookings Booking[]

  @@index([tenantId, venueId, startsAt])
  @@index([filmId, startsAt])
}

enum SeatState {
  AVAILABLE
  HELD
  SOLD
  BLOCKED
}

/// Live commercial state of one seat for one screening. Authoritative.
model ScreeningSeat {
  screeningId String
  screening   Screening @relation(fields: [screeningId], references: [id], onDelete: Cascade)
  seatId      String
  state       SeatState @default(AVAILABLE)
  holdId      String?
  heldUntil   DateTime?
  bookingId   String?
  version     Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@id([screeningId, seatId])
  @@index([holdId])
}

enum HoldStatus {
  ACTIVE
  CONVERTED
  RELEASED
  EXPIRED
}

model SeatHold {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  screeningId String
  screening   Screening  @relation(fields: [screeningId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status      HoldStatus @default(ACTIVE)
  seatIds     String[]
  expiresAt   DateTime
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  booking Booking?

  @@index([status, expiresAt])
}

// ---------------------------------------------------------------------------
// Pricing
// ---------------------------------------------------------------------------

model TicketType {
  id            String  @id @default(cuid())
  tenantId      String
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code          String
  name          String
  description   String?
  requiresProof Boolean @default(false)
  sortOrder     Int     @default(0)

  priceRules PriceRule[]

  @@unique([tenantId, code])
}

/// Base price for a ticket type in a seat price category.
model PriceRule {
  id            String     @id @default(cuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketTypeId  String
  ticketType    TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  priceCategory String
  amountMinor   Int

  @@unique([ticketTypeId, priceCategory])
}

model FormatSupplement {
  id          String @id @default(cuid())
  tenantId    String
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  format      String
  amountMinor Int

  @@unique([tenantId, format])
}

// ---------------------------------------------------------------------------
// Customers, bookings, payments, tickets
// ---------------------------------------------------------------------------

enum CustomerKind {
  GUEST
  REGISTERED
}

model Customer {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind        CustomerKind @default(GUEST)
  email       String?
  displayName String?
  createdAt   DateTime     @default(now())

  holds      SeatHold[]
  bookings   Booking[]
  favourites FavouriteVenue[]
  loyalty    LoyaltyAccount?
  membership Membership?
}

model FavouriteVenue {
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  venueId    String
  venue      Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([customerId, venueId])
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  REFUNDED
}

model Booking {
  id                      String        @id @default(cuid())
  tenantId                String
  tenant                  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reference               String        @unique
  customerId              String
  customer                Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  screeningId             String
  screening               Screening     @relation(fields: [screeningId], references: [id], onDelete: Cascade)
  holdId                  String        @unique
  hold                    SeatHold      @relation(fields: [holdId], references: [id])
  status                  BookingStatus
  subtotalMinor           Int
  /// Food and drink subtotal (included in totalMinor).
  concessionsMinor        Int           @default(0)
  feesMinor               Int
  /// Sum of every discount (membership, voucher, points).
  discountMinor           Int           @default(0)
  voucherCode             String?
  membershipDiscountMinor Int           @default(0)
  membershipPlanName      String?
  pointsRedeemed          Int           @default(0)
  pointsDiscountMinor     Int           @default(0)
  pointsEarned            Int           @default(0)
  /// "collect" | "seatDelivery"
  fulfilment              String        @default("collect")
  cancelledAt             DateTime?
  totalMinor              Int
  currency                String
  createdAt               DateTime      @default(now())
  confirmedAt             DateTime?

  seats       BookingSeat[]
  payments    Payment[]
  tickets     AdmissionTicket[]
  walletPass  WalletPass?
  concessions BookingConcession[]
  refunds     Refund[]
}

model BookingConcession {
  id             String  @id @default(cuid())
  bookingId      String
  booking        Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  productId      String
  name           String
  quantity       Int
  unitPriceMinor Int
  /// [{ groupId, optionIds, label, priceMinor }]
  modifiers      Json    @default("[]")
  lineTotalMinor Int
}

model Refund {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentRef  String
  amountMinor Int
  reason      String
  createdAt   DateTime @default(now())
}

/// Discount codes. Redemptions are counted inside the booking transaction.
model Voucher {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code           String
  description    String
  /// "percentOff" | "amountOff"
  kind           String
  value          Int
  /// "tickets" | "concessions" | "all"
  appliesTo      String    @default("all")
  minSpendMinor  Int       @default(0)
  validFrom      DateTime?
  validTo        DateTime?
  maxRedemptions Int?
  redemptions    Int       @default(0)
  active         Boolean   @default(true)
  /// Null = valid at every cinema.
  venueId        String?

  @@unique([tenantId, code])
}

/// Operator promotion shown on the customer home screen. The action links to a
/// film, a voucher code or an https page. Voucher promotions are hidden while
/// the voucher cannot be redeemed, so customers never see a dead code.
model Promotion {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  body        String
  ctaLabel    String
  /// "film" | "voucher" | "link" | "none"
  action      String
  filmId      String?
  voucherCode String?
  linkUrl     String?
  /// Null shows the promotion at every cinema.
  venueId     String?
  validFrom   DateTime?
  validTo     DateTime?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, active])
}

/// Sold seat. A partial unique index (see migration) guarantees a seat can only
/// be actively sold once per screening, independent of application logic.
model BookingSeat {
  id           String  @id @default(cuid())
  bookingId    String
  booking      Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  screeningId  String
  seatId       String
  rowLabel     String
  seatLabel    String
  ticketTypeId String
  priceMinor   Int
  active       Boolean @default(true)
}

enum PaymentStatus {
  AUTHORISED
  CAPTURED
  DECLINED
  REFUNDED
}

model Payment {
  id            String        @id @default(cuid())
  tenantId      String
  bookingId     String
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider      String
  providerRef   String
  status        PaymentStatus
  amountMinor   Int
  currency      String
  failureReason String?
  createdAt     DateTime      @default(now())

  @@unique([provider, providerRef])
}

model AdmissionTicket {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  /// Signed admission payload encoded in the QR code.
  barcode   String   @unique
  status    String   @default("VALID")
  createdAt DateTime @default(now())
}

enum WalletPassStatus {
  DEMO_UNSIGNED
  ISSUED
  VOIDED
}

model WalletPass {
  id                  String           @id @default(cuid())
  bookingId           String           @unique
  booking             Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  passTypeIdentifier  String
  serialNumber        String           @unique
  authenticationToken String
  status              WalletPassStatus
  updatedAt           DateTime         @updatedAt
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  tenantId       String
  scope          String
  key            String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())

  @@unique([tenantId, scope, key])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  sessionId  String?
  properties Json     @default("{}")
  occurredAt DateTime
  receivedAt DateTime @default(now())

  @@index([tenantId, name, occurredAt])
}

// ---------------------------------------------------------------------------
// Phase 3 domains (modelled now so boundaries are explicit; not yet exposed)
// ---------------------------------------------------------------------------

/// Paid membership plan. Benefits are applied by the server at quote time.
/// Entitlements (validated in code): { ticketDiscountPercent, foodDiscountPercent,
/// bookingFeeWaived, pointsMultiplier }.
model MembershipPlan {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  description  String       @default("")
  entitlements Json
  priceMinor   Int
  /// "month" | "year"
  interval     String
  active       Boolean      @default(true)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  memberships  Membership[]
}

/// A customer's membership. One per customer; renewing extends the period.
/// Renewal is manual until a real payment provider supports recurring billing.
model Membership {
  id               String               @id @default(cuid())
  tenantId         String
  customerId       String               @unique
  customer         Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  planId           String
  plan             MembershipPlan       @relation(fields: [planId], references: [id])
  startedAt        DateTime
  currentPeriodEnd DateTime
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  purchases        MembershipPurchase[]

  @@index([tenantId, planId])
}

model MembershipPurchase {
  id           String     @id @default(cuid())
  tenantId     String
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  planId       String
  provider     String
  providerRef  String
  amountMinor  Int
  currency     String
  periodStart  DateTime
  periodEnd    DateTime
  createdAt    DateTime   @default(now())

  @@unique([provider, providerRef])
}

model ConcessionProduct {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Null = available at every venue.
  venueId        String?
  sku            String
  name           String
  description    String?
  category       String
  priceMinor     Int
  allergens      String[]
  dietary        String[]
  calories       Int?
  /// "inStock" | "low" | "out"
  stockStatus    String   @default("inStock")
  available      Boolean  @default(true)
  /// [{ id, name, min, max, options: [{ id, name, priceMinor }] }]
  modifierGroups Json     @default("[]")
  /// Bundle components shown to the customer, e.g. ["Large popcorn", "2 × regular drink"].
  bundleItems    String[]
  imageAssetId   String?
  sortOrder      Int      @default(0)
  /// Shown in the app's Specials row.
  featured       Boolean  @default(false)
  /// Short label on the card, e.g. "Limited edition" or "Winter special".
  badge          String?
  /// Price before the deal, for bundles and offers ("was £17.45"). Must be above priceMinor.
  compareAtMinor Int?
  /// Film tie-in, e.g. a collectable bucket. Null = not linked to a film.
  filmId         String?
  limitedEdition Boolean  @default(false)
  /// Sale window. Outside it the product is hidden from the menu and cannot be ordered.
  availableFrom  DateTime?
  availableUntil DateTime?

  @@unique([tenantId, sku])
}

/// Phase 3: loyalty points ledger (internal; no external scheme integrated).
/// Operator loyalty scheme. Points are earned on what the customer paid
/// (excluding booking fees) and redeemed in whole-pound steps.
model LoyaltyProgram {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                 String
  enabled              Boolean  @default(true)
  earnPointsPerPound   Int
  redeemPointsPerPound Int
  minRedeemPoints      Int      @default(0)
  updatedAt            DateTime @updatedAt
}

model LoyaltyAccount {
  id         String               @id @default(cuid())
  tenantId   String
  customerId String               @unique
  customer   Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  points     Int                  @default(0)
  tier       String               @default("standard")
  updatedAt  DateTime             @updatedAt
  entries    LoyaltyLedgerEntry[]
}

/// Append-only points history. `points` is signed.
model LoyaltyLedgerEntry {
  id           String         @id @default(cuid())
  accountId    String
  account      LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  points       Int
  /// "earn" | "redeem" | "reverse_earn" | "refund_redeem" | "adjust"
  reason       String
  description  String         @default("")
  balanceAfter Int            @default(0)
  bookingId    String?
  createdAt    DateTime       @default(now())

  @@index([accountId, createdAt])
}

/// Phase 3: stored-value gift cards. Modelled only; issuing stored value has
/// regulatory and accounting implications that need operator sign-off.
model GiftCard {
  id           String    @id @default(cuid())
  tenantId     String
  codeHash     String    @unique
  balanceMinor Int
  currency     String
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
}

model NotificationRegistration {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  apnsToken  String
  createdAt  DateTime @default(now())

  @@unique([tenantId, apnsToken])
}

// ---------------------------------------------------------------------------
// Integrations: partner API keys, outgoing webhooks, shifts from rota systems.
// See docs/integrations.md.
// ---------------------------------------------------------------------------

/// A key a partner system uses to call /v1/partner. Only a SHA-256 hash is stored;
/// the key itself is shown once. Scopes limit what it can read or write.
model ApiKey {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  /// First characters of the key, shown so people can tell keys apart (e.g. "sf_live_a1b2").
  prefix      String
  keyHash     String    @unique
  scopes      String[]
  createdById String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  @@index([tenantId])
}

/// An HTTPS endpoint that receives signed events (booking confirmed, refunded…).
model Webhook {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url         String
  description String?
  events      String[]
  /// Shared secret for the HMAC signature. Shown once when the webhook is created.
  secret      String
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  deliveries  WebhookDelivery[]

  @@index([tenantId])
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  webhookId    String
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  /// The event id sent to the receiver, so it can ignore repeats.
  eventId      String
  payload      Json
  /// delivered or failed
  status       String
  responseCode Int?
  error        String?
  attempts     Int      @default(1)
  durationMs   Int?
  createdAt    DateTime @default(now())

  @@index([webhookId, createdAt])
}

/// A shift pushed in by a rota system (Planday, Deputy, RotaCloud…) or any partner
/// with the shifts:write scope. Upserted by (source, externalId).
model Shift {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venueId    String
  venue      Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  source     String
  externalId String
  staffName  String
  staffEmail String?
  role       String
  startsAt   DateTime
  endsAt     DateTime
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, source, externalId])
  @@index([tenantId, venueId, startsAt])
}
