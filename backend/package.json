{
  "name": "@cinema/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && pnpm db:seed",
    "fixtures:layouts": "ts-node --transpile-only src/fixtures/write-layouts.ts",
    "openapi": "ts-node --transpile-only scripts/export-openapi.ts",
    "test": "jest --runInBand"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@cinema/contracts": "workspace:^",
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/schedule": "^5",
    "@nestjs/swagger": "^11",
    "@prisma/client": "^6",
    "express": "^5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11",
    "@types/express": "^5.0.6",
    "@types/jest": "^29",
    "@types/node": "^22",
    "@types/supertest": "^7.2.1",
    "jest": "^29",
    "prisma": "^6",
    "supertest": "^7.3.1",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
